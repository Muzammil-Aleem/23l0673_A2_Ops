# Copy to .env and fill in. .env is git-ignored and docker-ignored: never commit it.

# ---- project ----
PROJECT_NAME=23l0673_A2_Ops
COMPOSE_PROJECT_NAME=23l0673_a2_ops

# ---- MLflow on DagsHub (Task 3.2) ----
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/23l0673_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# ---- Kaggle (optional, for training/download_data.py) ----
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- database (Compose) — use letters/digits only in the password, it goes into a URL ----
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me-strong-password
# local runs without Compose fall back to SQLite when DATABASE_URL is empty
DATABASE_URL=

# ---- web app ----
SECRET_KEY=change-me-random-string
WEB_PORT=8000
MAX_UPLOAD_MB=5
# optional: overrides the threshold stored with the champion model
# THRESHOLD=0.5
# local = model inside the web container; remote = call the cloud API (Task 8)
INFERENCE_MODE=local
# set WITH_TF=false together with INFERENCE_MODE=remote for a light web image
WITH_TF=true

# ---- cloud model API (Task 7/8) ----
MODEL_API_URL=https://<your-cloud-host>/predict
MODEL_API_KEY=<long-random-secret>
